# Postgres connection string.
#   Local: postgres://localhost/infinity_soma
#   Neon:  use the *pooled* connection string from the Neon console (host contains "-pooler").
DATABASE_URL=

# Email (https://resend.com). Without RESEND_API_KEY, emails are printed to the server console instead.
RESEND_API_KEY=
# Sender address on a domain verified in Resend.
EMAIL_FROM="Infinity Soma Wellness Clinic <bookings@infinitysoma.co.za>"
# Inbox that receives new booking and enquiry notifications (defaults to info@infinitysoma.co.za).
STAFF_EMAIL=

# Vercel Blob storage for special posters. Use a separate store locally so tests can never touch live posters.
# Careful: "vercel env pull" overwrites .env.local, including this value.
BLOB_READ_WRITE_TOKEN=

# One-time code for /dashboard/setup, which sets the shared staff password (only works while none is set).
SETUP_CODE=
