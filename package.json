{
  "name": "site",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.mts",
    "db:seed": "tsx --env-file=.env.local scripts/seed.mts",
    "db:menu": "tsx --env-file=.env.local scripts/apply-menu.mts",
    "db:live": "vercel env pull .env.production.local --environment=production --yes && tsx --env-file=.env.production.local scripts/migrate.mts && tsx --env-file=.env.production.local scripts/apply-menu.mts; rm -f .env.production.local",
    "password:set": "tsx --env-file=.env.local scripts/set-password.mts",
    "test": "vitest run"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "next": "16.4.2",
    "postgres": "^3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^4.1.12"
  }
}
